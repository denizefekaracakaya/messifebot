# /etc/messifebot.env — SADECE sunucuda. Sahibi root, grubu messifebot, izin 0640.
# BotFather'dan alınan YENİ (eski token iptal edilmiş) canlı bot token'ı
BOT_TOKEN=

# Bildirimlerin gideceği admin Telegram ID'leri (virgülle)
ADMIN_IDS=

# Haber API anahtarları (isteğe bağlı)
NEWSAPI_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=
CRYPTOCOMPARE_API_KEY=

# healthchecks.io ping URL'si, ör. https://hc-ping.com/xxxxxxxx-xxxx-...
HEALTHCHECK_URL=

# Değiştirmeyin
BOT_DATABASE_PATH=/var/lib/messifebot/chat_stats.db
BOT_VERSION_FILE=/var/lib/messifebot/version
