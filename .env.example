# MessifeBot ortam değişkenleri — bu dosyayı .env olarak kopyalayıp doldurun.
# Yerel geliştirmede CANLI botun değil, ayrı bir TEST botunun token'ını kullanın.
BOT_TOKEN=

# Bildirimlerin gideceği admin Telegram ID'leri (virgülle). Kendi ID'nizi bota /id yazarak öğrenin.
ADMIN_IDS=

# Haber API anahtarları (isteğe bağlı; boş olanlar atlanır)
NEWSAPI_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=
CRYPTOCOMPARE_API_KEY=

# healthchecks.io ping URL'si (isteğe bağlı; boşsa dış kontrol kapalı)
HEALTHCHECK_URL=

# Veritabanı yolu (boşsa telegram-bot/data/chat_stats.db)
BOT_DATABASE_PATH=
